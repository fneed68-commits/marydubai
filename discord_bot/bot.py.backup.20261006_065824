@bot.event
async def on_ready():
    print("=" * 60)
    print(f"✅ البوت يعمل: {bot.user}")
    print(f"📡 في {len(bot.guilds)} سيرفر")
    print("=" * 60)
    try:
        synced = await bot.tree.sync()
        print(f"✅ تم مزامنة {len(synced)} أمر")
        for cmd in synced:
            print(f"   /{cmd.name}")
    except Exception as e:
        print(f"❌ خطأ في المزامنة: {e}")


