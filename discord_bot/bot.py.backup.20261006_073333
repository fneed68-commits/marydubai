@bot.tree.command(name="stats", description="إحصائيات المبيعات")
async def stats_command(interaction: discord.Interaction):
    await interaction.response.defer()
    
    # قراءة الإحصائيات من sales_log
    import json
    log_file = os.path.expanduser("~/termux_secops_project/sales/sales_log.json")
    
    sales_count = 0
    total_revenue = 0
    
    if os.path.exists(log_file):
        try:
            with open(log_file, 'r', encoding='utf-8') as f:
                data = json.load(f)
                sales_count = len(data.get('sales', []))
                total_revenue = data.get('total_revenue', 0)
        except:
            pass
    
    embed = discord.Embed(
        title="📊 إحصائيات MaryDubai",
        description="البيانات المباشرة من سجل المبيعات",
        color=COLORS["warning"],
    )
    
    embed.add_field(
        name="🛒 إجمالي المبيعات",
        value=f"**{sales_count}** عملية",
        inline=True,
    )
    embed.add_field(
        name="💰 إجمالي الإيرادات",
        value=f"**${total_revenue}**",
        inline=True,
    )
    embed.add_field(
        name="📈 متوسط البيع",
        value=f"**${total_revenue / sales_count:.2f}**" if sales_count > 0 else "**$0**",
        inline=True,
    )
    
    embed.set_footer(text="MaryDubai Analytics")
    await interaction.followup.send(embed=embed)


